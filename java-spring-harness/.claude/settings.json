{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./mvnw *)", "Bash(mvn *)", "Bash(./gradlew *)", "Bash(gradle *)", "Bash(java *)",
      "Bash(git status*)", "Bash(git diff*)", "Bash(git log*)", "Bash(git show*)"
    ],
    "deny": [
      "Bash(./mvnw deploy*)", "Bash(mvn deploy*)", "Bash(./gradlew publish*)", "Bash(gradle publish*)",
      "Bash(./mvnw release:*)", "Bash(mvn release:*)",
      "Read(./**/.env)", "Read(./**/*.jks)", "Read(./**/*.p12)", "Read(./**/application-prod*.yml)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/java-post-edit.sh", "timeout": 30 }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/java-stop-compile.sh", "timeout": 300 }]
      }
    ]
  }
}
